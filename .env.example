# ==============================================================================
# QRbey Environment Configuration Template (.env.example)
# Copia este archivo como .env y completa los valores correspondientes
# ==============================================================================

# UptimeRobot API Configuration (devOpsAgent Keep-Alive)
UPTIMEROBOT_API_KEY=u3911782-tu_clave_aqui

# Puerto y Entorno de Ejecución
PORT=3030
NODE_ENV=production

# Google OAuth 2.0 Credentials (Para login de usuarios en el cliente)
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# Google Cloud Storage Configuration (Persistencia en la Nube)
GCS_KEY_FILE=gcs-key.json
# Alternativa para Render: cargar la llave en base64 para no subir archivos físicos
# GCS_KEY_BASE64=
GCS_BUCKET_NAME=qr-studio-pro-bucket

# ==============================================================================
# Configuración Centralizada de Planes y Cuotas
# ==============================================================================
# Plan Activo Predeterminado para Nuevos Usuarios
PLAN=free

# Límites del Plan Gratuito (Starter)
PLAN_FREE_MAX_DOWNLOADS=15
PLAN_FREE_MAX_CREDITS=50

# Límites y Precios del Plan Profesional (Pro)
PLAN_PRO_PRICE_MONTHLY=9.99
PLAN_PRO_MAX_DOWNLOADS=500
PLAN_PRO_MAX_CREDITS=2000

# Límites y Precios del Plan Corporativo (Enterprise)
PLAN_CORP_PRICE_MONTHLY=29.99
PLAN_CORP_MAX_DOWNLOADS=2000
PLAN_CORP_MAX_CREDITS=10000

# ==============================================================================
# Base de Datos Relacional TiDB Cloud (tidbcloud.com - MySQL Serverless)
# ==============================================================================
# Cadena de conexión TiDB Cloud MySQL compatible (con SSL obligatorio)
# Ejemplo: mysql://<usuario>.<prefijo>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<nombre_bd>?ssl={"rejectUnauthorized":true}
DATABASE_URL=
# Alternativa:
# TIDB_DATABASE_URL=

# ==============================================================================
# Pasarela de Pagos Recurrente (recurrente.com - GTQ / USD)
# ==============================================================================
# Modo: 'sandbox' para pruebas locales (simulador), 'production' para cobros reales
RECURRENTE_ENVIRONMENT=sandbox
# Llave secreta del servidor (en producción: sk_live_..., en pruebas: sk_test_...)
RECURRENTE_SECRET_KEY=sk_test_tu_clave_secreta_recurrente
# Llave pública opcional para integraciones legacy
RECURRENTE_PUBLIC_KEY=
# Secreto de firma del Webhook generado en Svix / Recurrente al registrar el endpoint
RECURRENTE_WEBHOOK_SECRET=whsec_tu_clave_secreta_webhook
# Moneda de facturación: 'USD' o 'GTQ'
RECURRENTE_CURRENCY=USD

# OnRender Deployment Automation (devOpsAgent Deploy Hook)
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-tu_service_id?key=tu_key

# URL base pública del sitio (usada para redirecciones de retorno de pago)
# En local: http://localhost:3030 | En producción: https://tu-app.onrender.com
APP_URL=http://localhost:3030

# ==============================================================================
# Soporte Omnicanal 24/7 & Asistente IA (supportAgent)
# ==============================================================================
# Clave oficial de la API de DeepSeek (platform.deepseek.com)
DEEPSEEK_API_KEY=sk-tu_clave_deepseek_aqui
# Clave opcional de Zhipu AI para conmutación por contingencia (Circuit Breaker)
ZHIPU_API_KEY=
# Número telefónico para atención en WhatsApp (con código de país, sin espacios ni '+')
WHATSAPP_SUPPORT_PHONE=529624503691
# Correo electrónico oficial de soporte
SUPPORT_EMAIL=qrbyeconctact@gmail.com

# Integración Meta Webhooks (Fase 3: Facebook Messenger e Instagram Direct)
META_VERIFY_TOKEN=qrbey_support_webhook_secure_token_2026
META_APP_SECRET=
PAGE_ACCESS_TOKEN=
PAGE_ID=1428779763652699
